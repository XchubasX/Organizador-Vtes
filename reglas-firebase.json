{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "statsReaders": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "banned": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "vtes_records": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.exists() && data.child('ownerUid').val() == auth.uid) || root.child('admins').child(auth.uid).val() == true || (data.exists() && !newData.exists() && data.child('recurrence').val() != 'weekly' && data.child('utcMs').isNumber() && ((data.child('modality').val() == 'presencial' && data.child('utcMs').val() + 86400000 < now) || (data.child('modality').val() != 'presencial' && data.child('utcMs').val() + 10800000 < now))))",
        ".validate": "newData.hasChildren(['type','name','utcTime','modality']) && (data.exists() || newData.hasChildren(['ownerUid','utcMs']))",
        "ownerUid": {
          ".validate": "newData.isString() && (newData.val() == data.val() || (!data.exists() && newData.val() == auth.uid))"
        },
        "type": {
          ".validate": "newData.isString() && newData.val() == 'custom_table'"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "utcTime": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && data.parent().child('recurrence').val() == 'weekly' && data.parent().child('utcMs').val() + 86400000 < now",
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "utcMs": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && data.parent().child('recurrence').val() == 'weekly' && data.val() + 86400000 < now && newData.val() > data.val() && newData.val() + 86400000 > now && newData.val() < now + 691200000",
          ".validate": "newData.isNumber()"
        },
        "originTz": {
          ".validate": "newData.isString() && newData.val().length < 60"
        },
        "modality": {
          ".validate": "newData.isString() && (newData.val() == 'virtual' || newData.val() == 'presencial')"
        },
        "recurrence": {
          ".validate": "newData.isString() && newData.val() == 'weekly'"
        },
        "deletePin": {
          ".validate": "newData.isString() && newData.val().length == 4"
        },
        "venue": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length < 60"
        },
        "city": {
          ".validate": "newData.isString() && newData.val().length < 100"
        },
        "mapsLink": {
          ".validate": "newData.isString() && newData.val().length < 500"
        },
        "platform": {
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "discord": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "gamePassword": {
          ".validate": "newData.isString() && newData.val().length < 100"
        },
        "format": {
          ".validate": "newData.isString() && (newData.val() == 'standard' || newData.val() == 'v5')"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "players": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && !newData.exists() && data.parent().child('recurrence').val() == 'weekly' && data.parent().child('utcMs').val() + 86400000 < now",
          ".validate": "data.exists()"
        },
        "substitutes": {
          ".validate": "data.exists()",
          "$i": {
            ".validate": "newData.isString() && newData.val().length < 100"
          }
        },
        "signups": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && !newData.exists() && data.parent().child('recurrence').val() == 'weekly' && data.parent().child('utcMs').val() + 86400000 < now",
          "$k": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && $k == auth.uid && data.parent().parent().child('type').exists()",
            ".validate": "newData.hasChildren(['uid','nick','at']) && (newData.child('uid').val() == auth.uid || newData.child('uid').val() == data.child('uid').val())",
            "uid": {
              ".validate": "newData.isString()"
            },
            "nick": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "arrival": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
            },
            "at": {
              ".validate": "newData.isNumber() && (newData.val() == data.val() || newData.val() == now)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() == true || root.child('statsReaders').child(auth.uid).val() == true)",
      "virtualTablesCreated": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "virtualJoins": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "presencialEventsCreated": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "presencialJoins": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "presencialByCity": {
        "$cityKey": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
          "name": {
            ".validate": "newData.isString() && newData.val().length < 100",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
          },
          "country": {
            ".validate": "newData.isString() && newData.val().length < 60",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
          },
          "eventsCreated": {
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists()"
          },
          "joins": {
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists()"
          }
        }
      },
      "presencialEventsLog": {
        "$eventId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
          "city": {
            ".validate": "newData.isString() && newData.val().length < 100",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
          },
          "country": {
            ".validate": "newData.isString() && newData.val().length < 60",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
          },
          "createdAt": {
            ".validate": "newData.isNumber()",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && !data.exists()"
          },
          "players": {
            "$nickKey": {
              ".validate": "newData.isString() && newData.val().length < 100",
              ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
            }
          }
        }
      },
      "tablesLog": {
        "$tableId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
          ".validate": "newData.hasChildren(['modality','startAt'])",
          "modality": {
            ".validate": "newData.isString() && (newData.val() == 'virtual' || newData.val() == 'presencial')",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val() || root.child('vtes_records').child($tableId).child('ownerUid').val() == auth.uid)"
          },
          "startAt": {
            ".validate": "newData.isString() && newData.val().length < 40",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val() || root.child('vtes_records').child($tableId).child('ownerUid').val() == auth.uid)"
          },
          "createdAt": {
            ".validate": "newData.isNumber()",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && !data.exists()"
          },
          "originTz": {
            ".validate": "newData.isString() && newData.val().length < 60",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val() || root.child('vtes_records').child($tableId).child('ownerUid').val() == auth.uid)"
          },
          "city": {
            ".validate": "newData.isString() && newData.val().length < 100",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val() || root.child('vtes_records').child($tableId).child('ownerUid').val() == auth.uid)"
          },
          "country": {
            ".validate": "newData.isString() && newData.val().length < 60",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val() || root.child('vtes_records').child($tableId).child('ownerUid').val() == auth.uid)"
          },
          "filled": {
            ".validate": "newData.isBoolean()",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.val() == true"
          },
          "players": {
            "$nickKey": {
              ".validate": "newData.isString() && newData.val().length < 100",
              ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
            }
          },
          "format": {
            ".validate": "newData.isString() && (newData.val() == 'standard' || newData.val() == 'v5')",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val() || root.child('vtes_records').child($tableId).child('ownerUid').val() == auth.uid)"
          },
          "subs": {
            "$nickKey": {
              ".validate": "newData.isString() && newData.val().length < 100",
              ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
            }
          },
          "promoted": {
            "$nickKey": {
              ".validate": "newData.isString() && newData.val().length < 100",
              ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.exists() && (!data.exists() || newData.val() == data.val())"
            }
          },
          "owner": {
            ".validate": "newData.isString() && newData.val().length < 128",
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && !data.exists()"
          },
          "uids": {
            "$uid": {
              ".validate": "newData.val() == true",
              ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && newData.val() == true"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
